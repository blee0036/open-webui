TEAM_DEPLOYMENT_NAME=open-webui-team
SANDBOX_NAMESPACE=owui
OPEN_WEBUI_PORT=3000
WEBUI_URL=https://ai.example.com
# Generate four independent 64-character hex values; never commit the filled env file.
POSTGRES_PASSWORD=
WEBUI_SECRET_KEY=
SANDBOX_CONTROLLER_KEY=
SEARXNG_SECRET=
# All public domains/IP ranges serving WebUI, SSO gateways or internal administration.
SANDBOX_EGRESS_DENY_HOSTS=ai.example.com
SANDBOX_EGRESS_DENY_CIDRS=
# Empty by default. Add exact, reviewed origins only (including the port).
PERSONAL_MCP_ALLOWED_PRIVATE_ORIGINS=
# Prebuilt images (amd64 + arm64) from .github/workflows/team-images.yaml.
# latest follows main; pin sha-<commit> or a vX.Y.Z tag in production. All three images share the tag.
TEAM_IMAGE_REGISTRY=ghcr.io/blee0036
TEAM_IMAGE_TAG=latest
# Sized for 8 cores / 32 GB. Allow ~2 GiB free RAM per sandbox (e.g. 2-4 on a 16 GB host).
SANDBOX_MAX_RUNNING=10
SANDBOX_IDLE_SECONDS=600
# Built-in workspace browser (model browser tools + Browser tab). Off by default.
SANDBOX_ENABLE_BROWSER=false
